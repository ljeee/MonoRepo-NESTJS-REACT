# Variables del ENTORNO LOCAL de pruebas en Docker (scripts\docker-local.ps1 las pasa con --env-file).
# Son valores de PRUEBA, sin secretos: el .env real (token del túnel, correo) no se lee. No los uses en producción.
COMPOSE_PROJECT_NAME=pos-local
DB_PASSWORD=local
JWT_SECRET=pruebas-locales-no-usar-en-produccion-0001
JWT_EXPIRES_IN=28800
# docker-local.ps1 agrega al arrancar las direcciones de la red local (http://IP-DEL-PC:8081).
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173
# Vacío a propósito: el POS web busca el API en el puerto 3000 del mismo equipo (localhost o la IP de la red).
EXPO_PUBLIC_API_BASE_URL=
CLOUDFLARE_TUNNEL_TOKEN=
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
REPORT_EMAIL=
COMPANY_NAME=Dfiru (pruebas locales)
