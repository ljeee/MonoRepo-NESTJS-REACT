{
  "mcpServers": {
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "chrome",
        "--isolated",
        "--output-dir",
        ".playwright-mcp",
        "--allowed-origins",
        "http://localhost:8081;http://127.0.0.1:8081;http://localhost:3000;http://127.0.0.1:3000;http://localhost:5173;https://fonts.googleapis.com;https://fonts.gstatic.com"
      ]
    }
  }
}
